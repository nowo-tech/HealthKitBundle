    locales: [],
    nav: [
        {label: 'Overview', route: 'demo_home', section: 'Demo'},
        {label: '/health/live', route: 'nowo_health_kit_live', section: 'Bundle endpoints'},
        {label: '/health/ready', route: 'nowo_health_kit_ready', section: 'Bundle endpoints'},
        {label: '/metrics', route: 'nowo_health_kit_metrics', section: 'Bundle endpoints'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Health Kit Bundle demo{% endblock %}{% endblock %}
