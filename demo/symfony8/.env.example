# APP_ENV: Symfony environment (dev/test/prod). In demos it is usually `dev`.
APP_ENV=dev

# APP_DEBUG: Enable/disable detailed debug output (usually `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: Secret used for signing/tokens. Use a local-only value in demos.
APP_SECRET=CHANGE_ME_LOCAL_SECRET

# APP_VERSION: Version string shown by /health/live (nowo_health_kit.version).
APP_VERSION=demo-1.0.0

# PORT: Host port mapped to HTTP :80 inside the FrankenPHP container (symfony8 demo default: 8197).
PORT=8197

# DEFAULT_URI: Base URL for generating URLs in CLI (must match PORT for local HTTP checks).
DEFAULT_URI=http://localhost:8197

# DATABASE_URL: MySQL inside Compose (service hostname `database`). Do not use sqlite:// or *.db files in demos.
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.4&charset=utf8mb4"

# REDIS_URL: Redis inside Compose (service hostname `redis`), pinged by the readiness probe.
REDIS_URL=redis://redis:6379

# MESSENGER_TRANSPORT_DSN: Doctrine transport for the demo `async` queue (countable, so the probe reports its depth).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

# HEALTH_DETAILS_TOKEN: Bearer token that unlocks probe details (>= 16 chars). Local placeholder only.
HEALTH_DETAILS_TOKEN=demo-details-token-change-me

# METRICS_TOKEN: Bearer token for /metrics scrapers (>= 16 chars). Local placeholder only.
METRICS_TOKEN=demo-metrics-token-change-me

# TRUSTED_PROXIES: Proxies whose X-Forwarded-* headers are trusted (empty in the demo: direct HTTP).
TRUSTED_PROXIES=
